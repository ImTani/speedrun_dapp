# Copy to `.env` (gitignored) and fill in. Never commit real values.

# ── SmoothSend (server-side sk_ keys only — no key ships to the browser) ──
SMOOTHSEND_SK_FUJI=
SMOOTHSEND_SK_MAINNET=

# ── Privy ──
NEXT_PUBLIC_PRIVY_APP_ID=
# Server-side verification of Privy access tokens in Vercel API routes.
PRIVY_APP_SECRET=

# ── Database (Neon Postgres; pooled connection string) ──
DATABASE_URL=

# ── Chain ──
# Defaults to the public Avalanche endpoints if unset.
FUJI_RPC_URL=
AVALANCHE_RPC_URL=

# ── Web push (optional): generate with `npx web-push generate-vapid-keys` ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Vestry (optional): where cosmetic-pack payments go; defaults to the deployer ──
VESTRY_TREASURY=

# Role and agent keys are generated locally by the runner into .secrets/ (gitignored):
# `pnpm --filter @arena/runner roles -- fuji` and `pnpm --filter @arena/runner start -- setup`.
