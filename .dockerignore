# Build context for apps/runner/Dockerfile (docker build -f apps/runner/Dockerfile .). Secrets are mounted at runtime.
# Never upload secrets or private docs.
.env
.env.*
.secrets
.private
**/.data
# Not needed by the runner image
**/node_modules
**/.next
.git
.claude
.worktrees
apps/web/*
!apps/web/package.json
# The runner imports these two (Mark definitions and their push text).
!apps/web/src
apps/web/src/*
!apps/web/src/game
apps/web/src/game/*
!apps/web/src/game/marks.ts
!apps/web/src/lexicon
apps/web/src/lexicon/*
!apps/web/src/lexicon/marks.ts
/contracts/*
!/contracts/deployments
