# Secrets — never commit. Deployer key lives in ~/.foundry/keystores, not here.
.env
.env.*
!.env.example
*.password
*.key
keystore*/

# Dependencies / build output
node_modules/
.pnpm-store/
.next/
out/
dist/
build/
.turbo/
.vercel/
coverage/

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/*/31337/
contracts/broadcast/**/dry-run/

# Git worktrees for parallel work
.worktrees/
.claude/worktrees/

# Claude Code — per-machine settings stay local; shared settings.json is tracked
.claude/settings.local.json

# Impeccable: platform-specific engine binary (19 MB); the launcher re-downloads it on first run
.claude/skills/impeccable/scripts/bin/
.impeccable/*.local.json

# OS / editor
.DS_Store
Thumbs.db
*.log

# Private planning docs (grant/strategy notes) — own local git repo, never pushed with the app
.private/

# Soldeer-installed Solidity deps (pinned in contracts/soldeer.lock)
contracts/dependencies/

# Locally generated test keys (M0 spike agent owners)
.secrets/

# Impeccable local state and review captures (large, regenerable)
apps/web/.impeccable/review/
apps/web/.impeccable/hook.cache.json
apps/web/.impeccable/questions/
*.stackdump
contracts/broadcast/**/*.lock

# Runner spend ledger (per network)
apps/runner/.data/

.vercel

# TypeScript incremental build info
*.tsbuildinfo
