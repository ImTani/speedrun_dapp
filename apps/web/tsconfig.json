{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["dom", "dom.iterable", "esnext"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"allowJs": true,
		"checkJs": false,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"declaration": false,
		"sourceMap": false,
		"incremental": true,
		"plugins": [{ "name": "next" }],
		"paths": { "@/*": ["./src/*"] }
	},
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
	"exclude": ["node_modules", ".impeccable"]
}
