{
	"name": "agent-arena",
	"private": true,
	"packageManager": "pnpm@11.5.2",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "pnpm -r --filter ./packages/* build && pnpm -r --filter ./apps/* build",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -r test",
		"test:contracts": "cd contracts && forge test",
		"lint": "biome check apps packages",
		"format": "biome check --write apps packages",
		"check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:contracts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"typescript": "7.0.2"
	}
}
